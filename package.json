{
  "name": "anomaly-detected-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && node scripts/promote-default-locale.mjs && pagefind --site out && node scripts/prune-pagefind.mjs && node scripts/check-internal-leaks.mjs",
    "start": "node scripts/serve-out.mjs",
    "preview": "node scripts/serve-out.mjs",
    "lint": "eslint --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "check:swap": "node scripts/check-swap.mjs",
    "check:leaks": "node scripts/check-internal-leaks.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:run && npm run check:swap",
    "hero:avif": "node scripts/make-hero-avif.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
